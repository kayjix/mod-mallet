{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreatedPaths",
  "description": "The plugin of paths as written into Mod Mallet's own folder.",
  "type": "object",
  "properties": {
    "light": {
      "description": "Whether it is flagged as light.",
      "type": "boolean"
    },
    "masters": {
      "description": "The plugins it names as masters. It loads after them.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "navmeshes": {
      "description": "The meshes it repairs.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "path": {
      "description": "The archive that holds it, ready for the mod manager; empty if\nnothing was written.",
      "type": "string"
    },
    "refused": {
      "description": "The meshes chosen that it does not repair, and why.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RefusedPath"
      }
    }
  },
  "required": [
    "path",
    "navmeshes",
    "masters",
    "light",
    "refused"
  ],
  "$defs": {
    "PathRefusal": {
      "description": "Why a mesh is not repaired.",
      "oneOf": [
        {
          "description": "Nothing over hidden objects runs on it any more, or it was not\nfound where the repair was asked for.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "nothing-to-repair"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Its cell or worldspace has a field Mod Mallet does not know how to\ncopy.",
          "type": "object",
          "properties": {
            "field": {
              "description": "The record type and the field, such as `CELL XCWT`.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "unknown-field"
            }
          },
          "required": [
            "type",
            "field"
          ]
        },
        {
          "description": "Its cell or worldspace was not found, or names a plugin the patch\ncannot name.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "not-found"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "The game is not one whose plugins Mod Mallet can write.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "unsupported-game"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "RefusedPath": {
      "description": "A mesh that was chosen for repair but is not repaired.",
      "type": "object",
      "properties": {
        "navmesh": {
          "description": "The mesh, as in [`RepairedPaths::navmesh`].",
          "type": "string"
        },
        "reason": {
          "description": "Why.",
          "$ref": "#/$defs/PathRefusal"
        }
      },
      "required": [
        "navmesh",
        "reason"
      ]
    }
  }
}
