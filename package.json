{
  "name": "mod-mallet",
  "description": "Workspace root for Mod Mallet's JavaScript packages and shared tooling.",
  "private": true,
  "version": "0.2.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "integrations/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "desktop": "npm run tauri --workspace apps/desktop --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "json-schema-to-typescript": "16.0.0",
    "lefthook": "2.2.2"
  }
}
